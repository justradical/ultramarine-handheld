# SPDX-License-Identifier: GPL-2.0-only
# Anbernic RG 55G1 (Qualcomm SM4450) — kernel config fragment.
#
# Apply on top of the arm64 defconfig after the patch series is in the tree
# (the panel, joypad, interconnect and SM4450 glue symbols come from patches):
#   scripts/kconfig/merge_config.sh -m .config rg55g1.config required.config
#   make ARCH=arm64 olddefconfig
#
# Derived from the SM4450 subset of armada's armada-kernel.config.overrides
# (JPyke3/armada feat-rg55g1).

# ============================ (1) board drivers ============================

# Display: DRM_MSM is built in so it takes over the firmware framebuffer before
# userspace; as a module it binds too late and the panel handoff goes black.
# Everything it depends on is forced built in as well.
CONFIG_DRM=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_AUX_BRIDGE=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_MSM=y
CONFIG_SM_DISPCC_4450=y
CONFIG_DRM_PANEL_FOCALTECH_FT7131M=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
# A modular backlight PWM provider makes the panel bind late from the rootfs.
CONFIG_PWM=y
CONFIG_PWM_GPIO=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_QCOM_UBWC_CONFIG=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_IOMMU_IO_PGTABLE=y
CONFIG_TRACE_GPU_MEM=y

# GPU: Adreno 613 through the msm DRM driver (a630_sqe.fw + a613_zap.mbn).
CONFIG_SM_GPUCC_4450=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# Remote processors (ADSP for audio/battery, WPSS for Wi-Fi) and their plumbing.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PDR_MSG=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_APR=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_FASTRPC=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_PBS=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_SPM=y
CONFIG_QCOM_LMH=y
CONFIG_QCOM_WDT=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y

# PMIC: ADC, thermal alarm, power key, vibrator.
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_VADC_COMMON=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PM8XXX_VIBRATOR=m

# Battery, charger and USB-C through the ADSP pmic_glink firmware interface.
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_TYPEC_MUX_FSA4480=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# USB: DWC3 with the SM4450 QMP USB3/DP combo PHY.
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y

# Buses used by the joypad MCU, touch controller and speaker amplifiers.
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y

# Input: GPIO buttons + SPI MCU analog sticks, touchscreen, userspace pads.
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=m
CONFIG_JOYSTICK_SINGLEADC_JOYPAD=m
CONFIG_KEYBOARD_GPIO=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_INPUT_UINPUT=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Audio: LPASS macros + WCD937x headphone codec on SoundWire, two AW88166
# speaker amplifiers on Senary MI2S, all behind the Q6 AudioReach DSP.
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_WCD937X=m
CONFIG_SND_SOC_WCD937X_SDW=m
CONFIG_SND_SOC_AW88166=m
CONFIG_PINCTRL_SM8450_LPASS_LPI=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
# Fedora's snd-pcm modprobe rule pulls in snd-seq; keep it available.
CONFIG_SND_SEQUENCER=m

# Wi-Fi (WCN3950 on WPSS, ath10k SNOC) and Bluetooth (WCN3950 over UART).
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# Fan and thermal.
CONFIG_SENSORS_PWM_FAN=m
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_QCOM_TSENS=y

# Keep the firmware splash until DRM takes over (needs quiet).
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Fedora ships linux-firmware compressed (e.g. a630_sqe.fw.xz).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# ===================== (2) handheld tuning / optimisation =====================

CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ENERGY_MODEL=y
CONFIG_PREEMPT=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_PM=y
CONFIG_SUSPEND=y

CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_PSI=y
CONFIG_NTSYNC=y
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_EROFS_FS=m
CONFIG_OVERLAY_FS=m

# USB networking and VPN for headless bring-up.
CONFIG_TUN=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m

CONFIG_DYNAMIC_DEBUG=y
